# Backend environment variables (Render / local)
# Copy to Render dashboard → Environment, or use `dotnet user-secrets` locally.

# PostgreSQL (Render provides DATABASE_URL or individual vars)
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=studytracker;Username=postgres;Password=yourpassword

# SendGrid — required for password reset emails
SendGrid__ApiKey=SG.your_api_key_here
SendGrid__SenderEmail=verified-sender@yourdomain.com
SendGrid__SenderName=Study Tracker

# CORS — comma-separated frontend origins (production)
AllowedOrigins=https://your-frontend.onrender.com,http://localhost:5173

# Cookie auth (production behind HTTPS)
# AuthCookie__Secure=true
